{
  "name": "@agri/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "data",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "openapi": "tsx scripts/generate-openapi.ts",
    "eval": "AI_MOCK=1 vitest run --config vitest.eval.config.mts",
    "eval:real": "AI_MOCK=0 vitest run --config vitest.eval.config.mts",
    "eval:baseline": "node scripts/promote-eval-baseline.mjs",
    "eval:compare": "tsx scripts/compare-models.ts",
    "eval:summary": "tsx scripts/eval-summary.ts",
    "langfuse:dataset": "tsx --env-file-if-exists=.env scripts/langfuse-dataset-sync.ts",
    "langfuse:experiment": "tsx --env-file-if-exists=.env scripts/langfuse-experiment.ts",
    "index": "tsx --env-file-if-exists=.env scripts/build-index.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "test:db": "vitest run tests/db --no-file-parallelism"
  },
  "dependencies": {
    "@agri/shared": "workspace:*",
    "@ai-sdk/otel": "^1.0.170",
    "@langfuse/otel": "^6.1.1",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "ai": "7.0.170",
    "drizzle-orm": "0.45.4",
    "nestjs-pino": "^5.3.1",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "^9",
    "@langfuse/client": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "globals": "^16",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
