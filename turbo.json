{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "AI_MOCK",
    "CI_OFFLINE",
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "AI_GATEWAY_API_KEY",
    "OPEN_METEO_GEOCODING_URL",
    "OPEN_METEO_FORECAST_URL",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_SECRET_KEY",
    "LANGFUSE_BASE_URL",
    "LANGFUSE_ENVIRONMENT",
    "RATE_LIMIT_PER_MINUTE",
    "GLOBAL_RATE_LIMIT_PER_MINUTE",
    "TRUSTED_PROXY_HOPS",
    "EVAL_MODEL",
    "EVAL_RUNS",
    "EVAL_DELAY_MS",
    "EVAL_TAGS",
    "EVAL_RUN_ID",
    "EVAL_SUITE",
    "EVAL_COMPARE",
    "NEXT_TELEMETRY_DISABLED",
    "PORT",
    "LOG_LEVEL",
    "PROXY_AUTH_SECRET",
    "SWAGGER_ENABLED",
    "CACHE_DRIVER",
    "REDIS_URL",
    "API_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "eval": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
