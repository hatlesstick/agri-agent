{
  "name": "agri-agent",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "turbo run eval",
    "eval:real": "pnpm --filter @agri/web eval:real",
    "eval:baseline": "pnpm --filter @agri/web eval:baseline",
    "eval:compare": "pnpm --filter @agri/web eval:compare",
    "eval:summary": "pnpm --filter @agri/web eval:summary",
    "langfuse:dataset": "pnpm --filter @agri/web langfuse:dataset",
    "langfuse:experiment": "pnpm --filter @agri/web langfuse:experiment",
    "index": "pnpm --filter @agri/web index"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
