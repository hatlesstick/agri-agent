{
  "name": "agri-agent",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "turbo run eval",
    "eval:real": "turbo run build --filter=@agri/agent^... --output-logs=errors-only 1>&2 && pnpm --filter @agri/agent eval:real",
    "eval:baseline": "pnpm --filter @agri/agent eval:baseline",
    "eval:compare": "turbo run build --filter=@agri/agent^... --output-logs=errors-only 1>&2 && pnpm --filter @agri/agent eval:compare",
    "eval:summary": "turbo run build --filter=@agri/agent^... --output-logs=errors-only 1>&2 && pnpm --filter @agri/agent eval:summary",
    "langfuse:dataset": "turbo run build --filter=@agri/agent^... --output-logs=errors-only 1>&2 && pnpm --filter @agri/agent langfuse:dataset",
    "langfuse:experiment": "turbo run build --filter=@agri/agent^... --output-logs=errors-only 1>&2 && pnpm --filter @agri/agent langfuse:experiment",
    "index": "turbo run build --filter=@agri/agent^... --output-logs=errors-only 1>&2 && pnpm --filter @agri/agent index",
    "openapi": "turbo run build --filter=@agri/api^... --output-logs=errors-only 1>&2 && pnpm --filter @agri/api openapi"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
