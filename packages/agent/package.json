{
  "name": "@agri/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "eval": "AI_MOCK=1 vitest run --config vitest.eval.config.mts",
    "eval:real": "AI_MOCK=0 vitest run --config vitest.eval.config.mts",
    "eval:baseline": "node scripts/promote-eval-baseline.mjs",
    "eval:compare": "tsx scripts/compare-models.ts",
    "eval:summary": "tsx scripts/eval-summary.ts",
    "langfuse:dataset": "tsx --env-file=.env.local scripts/langfuse-dataset-sync.ts",
    "langfuse:experiment": "tsx --env-file=.env.local scripts/langfuse-experiment.ts",
    "index": "tsx --env-file=.env.local scripts/build-index.ts"
  },
  "dependencies": {
    "@agri/shared": "workspace:*",
    "@ai-sdk/otel": "^1.0.170",
    "@ai-sdk/provider": "4.0.37",
    "@ai-sdk/provider-utils": "5.0.79",
    "@langfuse/otel": "^6.1.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "ai": "^7.0.170",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@langfuse/client": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@types/node": "^22.20.5",
    "eslint": "^9",
    "globals": "^16.4.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
